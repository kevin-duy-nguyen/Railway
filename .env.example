# #digital-marketing ist privat - der Summy-Bot muss eingeladen werden,
# sonst schlaegt der Post fuer alle drei Marketing-Calls fehl.
SLACK_CHANNEL_MARKETING=C038WTQADUN
RECALL_REGION=us-west-2
# Ohne diesen Key legt Summy keine Tasks an, Summaries laufen normal weiter.
DRIFFT_PM_API_KEY=your_drifft_pm_api_key_here

# Google: legt das Volltext-Transkript als Doc in Drive ab und haengt den
# Link unter jede Zusammenfassung. Die Scopes haengen am Refresh-Token -
# er braucht drive.file (und calendar, falls der Kalender-Pfad bleiben soll).
# Fehlt einer der drei Werte, laeuft alles wie bisher, nur ohne Link.
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REFRESH_TOKEN=your_google_oauth_refresh_token
# Ordner-ID aus der Drive-URL. Ohne sie landen die Docs in "Meine Ablage"
# des autorisierten Kontos und sieht sonst niemand.
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id

# Optional: port override (default 3000)
PORT=3000
